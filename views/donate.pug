extends layout

block content
  .container
    .row.justify-content-center
      .col-md-8.text-center
        h1.display-4.mb-4 Support Resume Magic
        p.lead.mb-5 Help us keep Resume Magic free and open source. Your support makes a difference!

        .row.mb-5
          .col-md-4.mb-4
            .card.h-100
              .card-body
                h3.card-title.mb-3 Free
                h2.display-4.mb-3 $0
                ul.list-unstyled.mb-4
                  li.mb-2 ✓ All Resume Features
                  li.mb-2 ✓ Multiple Themes
                  li.mb-2 ✓ PDF Export
                  li.mb-2 ✓ GitHub Integration
                p.text-muted Always free and open source

          .col-md-4.mb-4
            .card.h-100.border-primary
              .card-body
                h3.card-title.mb-3 One-time
                h2.display-4.mb-3 $5
                ul.list-unstyled.mb-4
                  li.mb-2 ✓ All Free Features
                  li.mb-2 ✓ Support Development
                  li.mb-2 ✓ GitHub Sponsor Badge
                  li.mb-2 ✓ Our Eternal Gratitude
                a.btn.btn-primary(href="https://github.com/sponsors/leganux" target="_blank") Donate via GitHub

          .col-md-4.mb-4
            .card.h-100
              .card-body
                h3.card-title.mb-3 Monthly
                h2.display-4.mb-3 $2
                ul.list-unstyled.mb-4
                  li.mb-2 ✓ All Free Features
                  li.mb-2 ✓ Sustain Development
                  li.mb-2 ✓ Priority Support
                  li.mb-2 ✓ Special Mention
                a.btn.btn-outline-primary(href="https://github.com/sponsors/leganux" target="_blank") Become a Sponsor

        .card.mb-5
          .card-body
            h2.mb-4 Why Support Us?
            .row
              .col-md-6.mb-4
                h4 Open Source
                p We believe in keeping our code open and accessible to everyone. Your support helps maintain this vision.
              
              .col-md-6.mb-4
                h4 Continuous Development
                p Your donations enable us to add new features, themes, and improvements regularly.
              
              .col-md-6.mb-4
                h4 Server Costs
                p Help us cover hosting and infrastructure costs to keep the service running smoothly.
              
              .col-md-6.mb-4
                h4 Community
                p Join our growing community of supporters and help shape the future of Resume Magic.

        .card.bg-light
          .card-body
            h2.mb-4 Other Ways to Support
            .row
              .col-md-4.mb-4
                h4 Star on GitHub
                p Show your support by starring our repository
                a.btn.btn-outline-dark(href="https://github.com/leganux/resume_magic" target="_blank")
                  i.fab.fa-github.me-2
                  | Star Project
              
              .col-md-4.mb-4
                h4 Spread the Word
                p Share Resume Magic with your network
                .btn-group
                  a.btn.btn-outline-primary(href="https://twitter.com/intent/tweet?text=Check%20out%20Resume%20Magic%20-%20Create%20beautiful%20resumes%20hosted%20on%20GitHub!%20https://github.com/leganux/resume_magic" target="_blank")
                    i.fab.fa-twitter.me-2
                    | Share
                  a.btn.btn-outline-primary(href="https://www.linkedin.com/sharing/share-offsite/?url=https://github.com/leganux/resume_magic" target="_blank")
                    i.fab.fa-linkedin.me-2
                    | Share
              
              .col-md-4.mb-4
                h4 Contribute
                p Help improve the project
                a.btn.btn-outline-dark(href="https://github.com/leganux/resume_magic/issues" target="_blank")
                  i.fas.fa-code.me-2
                  | Contribute

        .mt-5
          p.text-muted Resume Magic is a project by 
            a(href="https://github.com/leganux" target="_blank") Leganux
            | . Thank you for your support!
